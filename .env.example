# Copy this file to .env and edit values as needed for your environment

# Postgres connection used by the app (docker-compose uses service name 'db')
DATABASE_URL=postgres://postgres:postgres@db:5432/authdemo

# Admin credentials (change in production)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-jwt-secret
EXPORT_JWT_SECRET=replace-this-export-secret

# Server
PORT=3000
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads
RETENTION_DAYS=365

# Optional SMTP settings for export emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_SECURE=false
